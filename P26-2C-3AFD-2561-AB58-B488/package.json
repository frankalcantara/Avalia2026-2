{
  "name": "commonplace-book",
  "version": "1.0.0",
  "description": "Projeto #41 - Acervo de Citações e Notas de Leitura (Commonplace Book)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler pages dev public --d1=DB",
    "db:local": "wrangler d1 execute commonplace-db --local --file=schema.sql",
    "db:remote": "wrangler d1 execute commonplace-db --remote --file=schema.sql",
    "deploy": "wrangler pages deploy public --project-name=commonplace-book"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
