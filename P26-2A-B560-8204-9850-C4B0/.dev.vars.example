# =====================================================================
# P26-2A-B560-8204-9850-C4B0 — Exemplo de variáveis locais
# =====================================================================
# Copie este arquivo para ".dev.vars" e preencha com os valores reais
# obtidos no Discord Developer Portal e gerados localmente:
#
#   PowerShell:  Copy-Item .dev.vars.example .dev.vars
#   Bash:        cp .dev.vars.example .dev.vars
#
# ATENÇÃO: o arquivo ".dev.vars" contém segredos e NUNCA deve ser
# commitado (já está listado no .gitignore). Em produção (Cloudflare
# Pages) os mesmos nomes são configurados pelo painel em
# Settings > Environment variables (encrypted) ou via
# "wrangler pages secret put" — e não neste arquivo.
# =====================================================================

# ID público da aplicação Discord (Developer Portal > OAuth2 > Client ID)
DISCORD_CLIENT_ID=

# Segredo da aplicação Discord (Developer Portal > OAuth2 > Client Secret) — confidencial
DISCORD_CLIENT_SECRET=

# Chave HMAC-SHA256 usada para assinar o cookie de sessão
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
