{
  "name": "soundroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev ./public --ip 127.0.0.1 --port 8788",
    "db:setup": "wrangler d1 migrations apply soundroom --local",
    "test": "npm run test:unit && npm run test:db && npm run test:integration",
    "test:unit": "node --test tests/api/health.test.js tests/api/auth.test.js tests/api/spotify.test.js tests/frontend/pagination.test.js tests/frontend/recommendation-policy.test.js",
    "test:integration": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/integration/run-local.ps1",
    "test:db": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/database/run-tests.ps1"
  },
  "devDependencies": {
    "wrangler": "4.159.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261109.1": true
  }
}
