{
  "name": "entrelivros-projeto-24",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Catálogo universitário de empréstimo e troca de livros físicos",
  "scripts": {
    "dev": "wrangler pages dev public --ip 127.0.0.1 --port 8788",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "build:check": "wrangler pages functions build functions --outdir .build",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261113.0-beta",
    "wrangler": "4.162.0"
  }
}
